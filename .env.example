# This project supports multiple CometChat environments (staging-us, prod-us,
# prod-eu, prod-in) — each gets its OWN file named .env.<APP_ENV>, loaded by
# env.js. This .env.example is the template for each of those files, not a
# file that gets loaded directly.
#
#   cp .env.example .env.staging-us     # then fill in staging-us's values
#   cp .env.example .env.prod-eu        # then fill in prod-eu's values, etc.
#
# Which one loads is picked by APP_ENV (defaults to staging-us — the only
# environment this suite runs against without extra confirmation, since it
# creates/deletes groups, sends messages, and bans/blocks users):
#
#   npx playwright test                                  # staging-us
#   APP_ENV=prod-eu CONFIRM_PROD=yes npx playwright test  # prod-eu, explicit

COMETCHAT_APP_ID=your-app-id
COMETCHAT_REGION=us
COMETCHAT_REST_API_KEY=your-rest-api-key

# Public HTTPS URL that reaches THIS environment's receiver — each
# environment should have its own dedicated receiver deployment (see README
# -> "Multiple environments"), not share one. Must end in /webhook, and this
# exact URL + Basic Auth must be configured as a webhook on this specific
# CometChat app in the Dashboard.
WEBHOOK_RECEIVER_URL=https://your-env-receiver.onrender.com/webhook
WEBHOOK_BASIC_AUTH_USER=qa
WEBHOOK_BASIC_AUTH_PASS=change-me

# Used by tests and the dashboard to query the receiver directly — this
# environment's receiver base URL, no path.
RECEIVER_QUERY_URL=https://your-env-receiver.onrender.com

# Only required for scripts/register-webhooks.js (webhook CRUD via
# CometChat's Multi-Tenancy Management API). Provisioned by CometChat Sales —
# the COMETCHAT_REST_API_KEY above does NOT work for this. Leave unset if
# you only run the test suite; see scripts/register-webhooks.js for details.
# COMETCHAT_MGMT_KEY=
# COMETCHAT_MGMT_SECRET=
