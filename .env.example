COMETCHAT_APP_ID=your-app-id
COMETCHAT_REGION=us
COMETCHAT_REST_API_KEY=your-rest-api-key

# Public HTTPS URL that reaches the local receiver — from cloudflared/ngrok,
# or your deployed receiver's own URL in CI. Must end in /webhook, and must
# be re-pasted into the CometChat Dashboard's webhook config every time a
# local tunnel restarts (the URL changes on each restart).
WEBHOOK_RECEIVER_URL=https://xxxx.trycloudflare.com/webhook
WEBHOOK_BASIC_AUTH_USER=qa
WEBHOOK_BASIC_AUTH_PASS=change-me

# Used by tests and the dashboard to query the receiver directly over
# localhost (not the public tunnel URL above).
RECEIVER_QUERY_URL=http://localhost:4001

# Only required for scripts/register-webhooks.js (webhook CRUD via
# CometChat's Multi-Tenancy Management API). Provisioned by CometChat Sales —
# the COMETCHAT_REST_API_KEY above does NOT work for this. Leave unset if
# you only run the test suite; see scripts/register-webhooks.js for details.
# COMETCHAT_MGMT_KEY=
# COMETCHAT_MGMT_SECRET=
